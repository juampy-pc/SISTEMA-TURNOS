# Variables de entorno necesarias

# La completa automáticamente Vercel cuando conectás Vercel Postgres
# desde el dashboard (Storage → Postgres → Connect Project). No hace
# falta escribirla a mano en producción.
POSTGRES_URL=postgres://usuario:clave@host:5432/basededatos

# Clave secreta para firmar las sesiones. Tiene que ser larga, aleatoria,
# y NUNCA compartirse. Generarla una vez y no volver a cambiarla (si se
# cambia, se cierra la sesión de todos los usuarios).
# Se puede generar una en la terminal con: openssl rand -base64 48
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria

# Identificador del negocio dentro de la base de datos. Tiene que coincidir
# con el "slug" cargado en la tabla "negocios" (ver db/schema.sql).
NEGOCIO_SLUG=miriam
